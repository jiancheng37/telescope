generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  reportName    String?   @map("report_name")
  accounts      Account[]
  sessions      Session[]
  reports       Report[]
  collections   Collection[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum ReportStatus {
  PROCESSING
  COMPLETE
}

model Report {
  id           String       @id @default(cuid())
  userId       String       @map("user_id")
  chatId       String?      @map("chat_id")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       ReportStatus @default(PROCESSING)
  title        String
  participantA String       @map("participant_a")
  participantB String       @map("participant_b")
  firstTs      Int          @map("first_ts")
  lastTs       Int          @map("last_ts")
  messageCount Int          @default(0) @map("message_count")
  hasAiInsights Boolean     @default(false) @map("has_ai_insights")
  analysis     Json?
  llm          Json?
  shareToken   String?      @unique @map("share_token")
  shareMessagesToken String? @unique @map("share_messages_token")
  sharedMessagesVisible Boolean @default(false) @map("shared_messages_visible")
  sharedEvidence Json?      @map("shared_evidence")
  createdAt    DateTime     @default(now()) @map("created_at")
  completedAt  DateTime?    @map("completed_at")
  collections  CollectionReport[]

  @@index([userId, createdAt(sort: Desc)])
  @@unique([userId, chatId])
  @@map("reports")
}

model Collection {
  id        String             @id @default(cuid())
  userId    String             @map("user_id")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  reports   CollectionReport[]
  createdAt DateTime           @default(now()) @map("created_at")

  @@unique([userId, name])
  @@index([userId, createdAt])
  @@map("collections")
}

model CollectionReport {
  collectionId String     @map("collection_id")
  reportId     String     @map("report_id")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  report       Report     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now()) @map("added_at")

  @@id([collectionId, reportId])
  @@index([reportId])
  @@map("collection_reports")
}
