# Do not copy this into a committed file. Configure these values in Vercel's
# Production environment and AWS Secrets Manager/ECS as documented below.

# Vercel / Next.js
DATABASE_URL="postgresql://production-pooled-url"
DIRECT_URL="postgresql://production-direct-url-if-available"
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AWS_REGION="ap-southeast-1"
AWS_S3_UPLOAD_BUCKET=""
AWS_SQS_ANALYSIS_QUEUE_URL=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
TELESCOPE_MAX_EXPORT_BYTES="52428800"
TELESCOPE_DAILY_ANALYSIS_LIMIT="3"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ECS worker (store sensitive values in AWS Secrets Manager)
OPENAI_API_KEY=""
TELESCOPE_MODEL="gpt-5-mini"
