{
  "name": "telescope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then CONFIRM_PRODUCTION_MIGRATION=1 npm run db:migrate:production; fi && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:local:up": "docker compose -f compose.dev.yml up -d --wait",
    "db:local:down": "docker compose -f compose.dev.yml down",
    "db:migrate": "npm run db:migrate:local",
    "db:migrate:local": "NODE_ENV=development prisma migrate deploy",
    "db:migrate:production": "tsx scripts/migrate-production.ts",
    "test": "vitest run",
    "report": "tsx scripts/report.ts",
    "deck": "tsx scripts/deck.ts",
    "render": "tsx scripts/render.tsx",
    "cache-probe": "tsx --env-file-if-exists=.env.local scripts/cache-probe.ts",
    "wrapped": "tsx --env-file-if-exists=.env.local scripts/wrapped.ts",
    "worker": "tsx scripts/analysis-worker-bootstrap.ts",
    "worker:dev": "NODE_ENV=development tsx scripts/analysis-worker-bootstrap.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/client-sqs": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nextjs": "^10.70.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "dotenv": "^17.4.2",
    "next": "^16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.4.0",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
