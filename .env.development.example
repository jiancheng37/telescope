# Copy to .env.development.local. This database is created by compose.dev.yml.
DATABASE_URL="postgresql://telescope:telescope-dev@localhost:5433/telescope"
DIRECT_URL="postgresql://telescope:telescope-dev@localhost:5433/telescope"

# Development-only application credentials.
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
OPENAI_API_KEY=""
TELESCOPE_MODEL="gpt-5-mini"

# LocalStack S3/SQS. These are emulated credentials, not secrets.
AWS_REGION="us-east-1"
AWS_ENDPOINT_URL="http://localhost:4566"
AWS_S3_UPLOAD_BUCKET="telescope-analysis-local"
AWS_SQS_ANALYSIS_QUEUE_URL="http://localhost:4566/000000000000/telescope-analysis"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
TELESCOPE_MAX_EXPORT_BYTES="52428800"
TELESCOPE_DAILY_ANALYSIS_LIMIT="3"
