# PostgreSQL connection URL used by the app, migrations, and Prisma scripts.
DATABASE_URL="postgresql://user:password@host:5432/telescope"

# Direct (non-pooled) PostgreSQL URL used by Prisma migrations and admin tools.
DIRECT_URL="postgresql://user:password@host:5432/telescope"

# Generate with: npx auth secret
AUTH_SECRET=""

# Google Cloud Console OAuth credentials. Callback URL in development:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

OPENAI_API_KEY=""
# Optional override.
TELESCOPE_MODEL="gpt-5-mini"

# Asynchronous analysis infrastructure. In ECS, prefer a task role over static
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY credentials.
AWS_REGION="ap-southeast-1"
AWS_S3_UPLOAD_BUCKET=""
AWS_SQS_ANALYSIS_QUEUE_URL=""

# Defaults to 50 MiB when omitted.
TELESCOPE_MAX_EXPORT_BYTES="52428800"
TELESCOPE_DAILY_ANALYSIS_LIMIT="3"

# Shared production API rate limiter. Local development uses memory instead.
# Vercel's Upstash Marketplace integration supplies the KV_* equivalents.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Canonical public origin, for example https://telescope.example.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional separate dashboard origin. When set, /app moves to this host.
NEXT_PUBLIC_APP_URL=""
